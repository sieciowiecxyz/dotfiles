#!/usr/bin/env bash
set -euo pipefail

cache_dir="${XDG_RUNTIME_DIR:-/tmp}/statusbar-${USER}"
cpu_env_file="$cache_dir/cpu.env"
cache_script="${HOME}/.local/bin/statusbar/sb-sysstat-cache"

case "${BLOCK_BUTTON:-0}" in
	1)
		"$cache_script" cpu >/dev/null 2>&1 || true
		if [[ -f "$cpu_env_file" ]]; then
			# shellcheck disable=SC1090
			source "$cpu_env_file"
			notify-send "CPU" "Usage: ${total_percent:-0}%\nTemp: ${cpu_temp_c:-0}C\nHistory: ${history:-}"
		fi
		exit 0
		;;
	2)
		if command -v btop >/dev/null 2>&1; then
			setsid -f "$TERMINAL" -e btop
		else
			setsid -f "$TERMINAL" -e htop
		fi
		exit 0
		;;
	3)
		notify-send "CPU" "Left to right: oldest to newest. Middle click opens btop/htop."
		exit 0
		;;
	6)
		setsid -f "$TERMINAL" -e "$EDITOR" "$0"
		exit 0
		;;
esac

"$cache_script" cpu >/dev/null 2>&1 || true
[[ -f "$cpu_env_file" ]] || exit 0

# shellcheck disable=SC1090
source "$cpu_env_file"
printf 'CPU%3s%% | %sC | CPU[%s]\n' "${total_percent:-0}" "${cpu_temp_c:-0}" "${history:-}"
