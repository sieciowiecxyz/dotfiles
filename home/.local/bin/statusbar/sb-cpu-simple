#!/usr/bin/env bash
set -euo pipefail

# Unified severity palette: default, green, yellow, orange-red.
# ^0^ restores the default text colour after each metric.
metric() {
	local value="$1" medium="$2" high="$3" very_high="$4" label="$5" colour=0
	if (( value >= very_high )); then colour=4
	elif (( value >= high )); then colour=3
	elif (( value >= medium )); then colour=2
	fi
	printf '^%s^%s^0^' "$colour" "$label"
}
load_metric() {
	metric "$1" 30 60 90 "${1}%"
}

cache_dir="${XDG_RUNTIME_DIR:-/tmp}/statusbar-${USER}"
cpu_env_file="$cache_dir/cpu.env"
cache_script="${HOME}/.local/bin/statusbar/sb-sysstat-cache"

cpu_hogs() {
	ps -eo pid=,comm=,%cpu= --sort=-%cpu |
		awk '
			BEGIN { n = 0 }
			$3 > 0 {
				printf "%-7s %-22s %5s%%\n", $1, $2, $3
				if (++n >= 5) exit
			}
		'
}

case "${BLOCK_BUTTON:-0}" in
	1)
		"$cache_script" cpu >/dev/null 2>&1 || true
		hogs="$(cpu_hogs)"
		notify-send "CPU hogs" "${hogs:-Brak aktywnych hogów}"
		exit 0
		;;
	2)
		if command -v btop >/dev/null 2>&1; then
			setsid -f "$TERMINAL" -e btop
		else
			setsid -f "$TERMINAL" -e htop
		fi
		exit 0
		;;
	6)
		setsid -f "$TERMINAL" -e "$EDITOR" "$0"
		exit 0
		;;
esac

"$cache_script" cpu >/dev/null 2>&1 || true
[[ -f "$cpu_env_file" ]] || exit 0

# shellcheck disable=SC1090
source "$cpu_env_file"
# MemAvailable includes reclaimable cache; no swap on this machine.
read -r ram_used ram_percent < <(awk '
 /MemTotal:/ {total=$2} /MemAvailable:/ {avail=$2}
 END {printf "%d %d\n", (total-avail)/1048576+0.5, 100*(total-avail)/total}
' /proc/meminfo)
printf '🧠%s %s %s\n' \
 "$(load_metric "${total_percent:-0}")" \
 "$(metric "${cpu_temp_c:-0}" 60 80 90 "${cpu_temp_c:-0}C")" \
 "$(metric "$ram_percent" 50 80 90 "${ram_used}G")"
