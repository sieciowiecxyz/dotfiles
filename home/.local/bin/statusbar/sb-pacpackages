#!/bin/sh

# Paru queries repo databases and AUR. Repo freshness follows the normal
# repository sync (cron/checkup); this read-only query never runs pacman -Sy.
updates=$(timeout 45 paru -Qu --color never)
result=$?
if [ "$result" -ne 0 ]; then
	printf '📦?\n'
	exit 0
fi
updates=$(printf '%s\n' "$updates" | awk 'NF && !/\[ignored\]/')
case ${BLOCK_BUTTON:-0} in
	1) setsid -f "$TERMINAL" -e sb-popupgrade ;;
	2) notify-send "Available updates (repo + AUR)" "${updates:-No updates}" ;;
	3) notify-send "🎁 Upgrade module" "Repo + AUR via paru. Left click: upgrade. Middle click: list. Repo databases follow the regular repository sync." ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac
count=$(printf '%s\n' "$updates" | awk 'NF {n++} END {print n+0}')
[ "$count" -eq 0 ] || printf '📦%s\n' "$count"
