#!/usr/bin/env bash
set -euo pipefail

cache_dir="${XDG_RUNTIME_DIR:-/tmp}/statusbar-${USER}"
gpu_env_file="$cache_dir/gpu.env"
cache_script="${HOME}/.local/bin/statusbar/sb-sysstat-cache"

format_gib() {
	awk -v mib="$1" 'BEGIN { printf "%.1f", mib / 1024 }'
}

case "${BLOCK_BUTTON:-0}" in
	1)
		"$cache_script" gpu >/dev/null 2>&1 || true
		if [[ -f "$gpu_env_file" ]]; then
			# shellcheck disable=SC1090
			source "$gpu_env_file"
			notify-send "VRAM" "Used: $(format_gib "${gpu_mem_used_mib:-0}") / $(format_gib "${gpu_mem_total_mib:-0}") GiB\nUsage: ${gpu_mem_percent:-0}%\nGPU temp: ${gpu_temp_c:-0}C"
		fi
		exit 0
		;;
	2)
		if command -v nvtop >/dev/null 2>&1; then
			setsid -f "$TERMINAL" -e nvtop
		else
			setsid -f "$TERMINAL" -e nvidia-smi
		fi
		exit 0
		;;
	3)
		notify-send "VRAM" "Shared with the GPU cache to keep the statusbar cheap."
		exit 0
		;;
	6)
		setsid -f "$TERMINAL" -e "$EDITOR" "$0"
		exit 0
		;;
esac

"$cache_script" gpu >/dev/null 2>&1 || true
[[ -f "$gpu_env_file" ]] || exit 0

# shellcheck disable=SC1090
source "$gpu_env_file"
(( ${gpu_available:-0} == 1 )) || exit 0
printf '💾%s/%sG\n' "$(format_gib "${gpu_mem_used_mib:-0}")" "$(format_gib "${gpu_mem_total_mib:-0}")"
