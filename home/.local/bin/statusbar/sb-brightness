#!/bin/bash

case $BLOCK_BUTTON in
	1) brightnessctl set 100%; pkill -RTMIN+10 "${STATUSBAR:-dwmblocks}" ;;
	2) brightnessctl set 1% ;;
	4) brightnessctl set +1%  ;;
	5) brightnessctl set 1%-  ;;
	3) notify-send "Brightness Block Lol
- Middle click to set brightness to 1%.
- Left Click to set brightness to 100%
- Scroll to set brightness" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

current_brightness=$(brightnessctl get)
max_brightness=$(brightnessctl max)
brightness_percent=$((current_brightness * 100 / max_brightness))


echo "💡$brightness_percent%"

