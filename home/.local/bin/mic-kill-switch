#!/bin/sh

# Toggle a real OS-level microphone kill switch for PipeWire/PulseAudio.
# It mutes every non-monitor source: physical inputs plus virtual mic filters.

custom_sound_muted="${XDG_DATA_HOME:-$HOME/.local/share}/dwm/sounds/mic-muted.oga"
sound_muted="/usr/share/sounds/freedesktop/stereo/dialog-warning.oga"
sound_muted_extra="/usr/share/sounds/freedesktop/stereo/bell.oga"
sound_unmuted="/usr/share/sounds/freedesktop/stereo/complete.oga"

notify() {
	notify-send "$@"
}

play_sound() {
	[ -r "$1" ] || return 0
	paplay --volume=65536 "$1" >/dev/null 2>&1
}

play_muted_sound() {
	(
		if [ -r "$custom_sound_muted" ]; then
			play_sound "$custom_sound_muted"
		else
			play_sound "$sound_muted"
			play_sound "$sound_muted_extra"
		fi
	) &
}

refresh_status() {
	pkill -RTMIN+12 "${STATUSBAR:-dwmblocks}" 2>/dev/null || true
}

sources() {
	pactl list short sources | awk '$2 !~ /\.monitor$/ { print $1 }'
}

source_count() {
	pactl list short sources | awk '$2 !~ /\.monitor$/ { count++ } END { print count + 0 }'
}

ids="$(sources)"
count="$(source_count)"

if [ "$count" -eq 0 ]; then
	notify -u critical "Microphone kill switch" "No input sources found."
	refresh_status
	exit 1
fi

mute=0
for id in $ids; do
	if ! pactl get-source-mute "$id" 2>/dev/null | grep -q 'yes$'; then
		mute=1
		break
	fi
done

if [ "$mute" -eq 1 ]; then
	for id in $ids; do
		pactl set-source-mute "$id" 1
	done
	play_muted_sound
	notify -u critical "Microphone kill switch" "MUTED $count input sources"
else
	for id in $ids; do
		pactl set-source-mute "$id" 0
	done
	play_sound "$sound_unmuted" &
	notify -u normal "Microphone kill switch" "UNMUTED $count input sources"
fi

refresh_status
